# Produção: configure estes valores somente no ambiente protegido `github-pages`.
# Desenvolvimento: copie este arquivo para `.env.local` e use somente o projeto
# Supabase Cloud de desenvolvimento. Para preservar o Pix compartilhado, as duas
# variáveis do Supabase também podem ficar em `.env.development.local`.
VITE_APP_ENV=development
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PIX_COPY_AND_PASTE=
VITE_PIX_RECEIVER_NAME=
VITE_PIX_RECEIVER_CITY=
